{
  "spec": "SourceSpec/1",
  "id": "toss",
  "version": "0.2.0",
  "vendor": "toss",
  "caveat": "토스증권's own public, non-account endpoints, relayed unread. The vendor issues one live session per client id and Aumos runs that flow; only the exact read-only market, instrument, and indicator paths below are signed, because at 토스 the credential that reads is also capable of trading. Nothing is bounded by asOf, no date is checked, and response shapes are the vendor's to change.",
  "hosts": ["openapi.tossinvest.com"],
  "headers": {
    "accept": "application/json"
  },
  "credentials": [
    { "name": "client-id", "header": "x-client-id", "required": true },
    { "name": "client-secret", "header": "x-client-secret", "required": true }
  ],
  "auth": {
    "kind": "oauth2-client-credentials",
    "tokenUrl": "https://openapi.tossinvest.com/oauth2/token",
    "clientId": "client-id",
    "clientSecret": "client-secret"
  },
  "endpoints": [
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/candles",
      "query": ["symbol", "interval", "count", "before", "adjusted"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/orderbook",
      "query": ["symbol"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/prices",
      "query": ["symbols"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/trades",
      "query": ["symbol", "count"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/price-limits",
      "query": ["symbol"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/stocks",
      "query": ["symbols"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/stocks/all",
      "query": ["market", "status", "securityType", "commonShare"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/stocks/{symbol}/warnings",
      "query": []
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/stocks/{symbol}/program-trades",
      "query": ["count", "until"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/stocks/{symbol}/credit-trades",
      "query": ["count", "until"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/stocks/{symbol}/securities-lending",
      "query": ["count", "until"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/stocks/{symbol}/investor-trading",
      "query": ["count", "until"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/stocks/{symbol}/short-selling",
      "query": ["count", "until"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/exchange-rate",
      "query": ["baseCurrency", "quoteCurrency", "dateTime"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/market-calendar/KR",
      "query": ["date"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/market-calendar/US",
      "query": ["date"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/rankings",
      "query": ["type", "marketCountry", "duration", "excludeInvestmentCaution", "count"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/market-indicators/prices",
      "query": ["symbols"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/market-indicators/{symbol}/candles",
      "query": ["interval", "count", "before"]
    },
    {
      "host": "openapi.tossinvest.com",
      "path": "/api/v1/market-indicators/{symbol}/investor-trading",
      "query": ["interval", "count", "until"]
    }
  ]
}
