{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-Gated Allocator — Global instance configuration",
  "description": "Safety-bounded operating thresholds. Configuration may make the manager stricter, but cannot waive missing evidence, freshness, mandate or thesis-challenge gates.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "reserveLiquiditySymbols": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9.-]{1,20}$"
      },
      "uniqueItems": true,
      "default": [],
      "description": "Assets explicitly classified by the investor as reserve liquidity for the selected sleeve. SGOV is not reserve liquidity unless listed here or in the current shared Brief."
    },
    "minimumExpectedActiveReturn": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 0.25,
      "default": 0.05,
      "description": "Minimum probability-weighted expected return above the named benchmark for a single-name BUY. Missing inputs do not become zero; they make the gate unresolved."
    },
    "concentration": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "position": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.25,
          "default": 0.1
        },
        "sector": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.4,
          "default": 0.2
        },
        "theme": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.3,
          "default": 0.15
        }
      }
    },
    "minimumLensSamples": {
      "type": "integer",
      "minimum": 5,
      "maximum": 100,
      "default": 10
    },
    "minimumIndependentDateClusters": {
      "type": "integer",
      "minimum": 2,
      "maximum": 20,
      "default": 4
    },
    "watchExpiryDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180,
      "default": 30
    },
    "freshnessHours": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "marketPrice": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 72,
          "default": 24
        },
        "filing": {
          "type": "number",
          "minimum": 1,
          "maximum": 8760,
          "default": 2160
        },
        "news": {
          "type": "number",
          "minimum": 1,
          "maximum": 336,
          "default": 72
        },
        "corporateAction": {
          "type": "number",
          "minimum": 1,
          "maximum": 720,
          "default": 168
        }
      }
    },
    "experimentalPositionCeiling": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 0.05,
      "default": 0.01,
      "description": "Maximum target weight while a lens is insufficient or observing. The Mandate and concentration limits may impose a lower ceiling."
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "releaseBufferMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 180,
          "default": 30,
          "description": "Delay after an exact release/checkpoint time before the at-time WATCH fires."
        },
        "bmoMinutesBeforeOpen": {
          "type": "integer",
          "minimum": 15,
          "maximum": 120,
          "default": 30
        },
        "retryMinutes": {
          "type": "integer",
          "minimum": 30,
          "maximum": 60,
          "default": 45
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 2
        },
        "krCloseBufferMinutes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 180,
          "default": 60
        },
        "usCloseBufferMinutes": {
          "type": "integer",
          "minimum": 10,
          "maximum": 240,
          "default": 60
        }
      }
    }
  }
}
