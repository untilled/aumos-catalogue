{
  "note": "The boundary cases from the review of d36e32b, kept as regressions. Each one names a base fixture and the mutations to apply to a **copy** of it — the fixture files themselves are never edited, which is the property the reviewer's own reproduction script had: a case that passes today has to keep passing for the same reason, and these say what has to keep failing. Every one of them returned a BUY or an increment before the fix.",
  "cases": [
    {
      "id": "an-unread-book-is-not-an-empty-account",
      "finding": 1,
      "kind": "evaluateCase",
      "base": "cases[0]",
      "mutations": [{ "op": "delete", "path": "book" }],
      "expect": {
        "route": "wait",
        "outcomeCode": "data_missing",
        "proposedAction": "WAIT",
        "incrementWeight": 0,
        "diagnosticCodes": ["account_state_unreadable"]
      }
    },
    {
      "id": "half-an-unread-book-is-still-unread",
      "finding": 1,
      "kind": "evaluateCase",
      "base": "cases[0]",
      "note": "Holdings were read and open proposals were not. Exposure that is about to exist is exactly the half that was missing.",
      "mutations": [{ "op": "delete", "path": "book.openProposals" }],
      "expect": { "route": "wait", "outcomeCode": "data_missing", "proposedAction": "WAIT", "diagnosticCodes": ["account_state_unreadable"] }
    },
    {
      "id": "no-concentration-caps-cannot-be-adjudicated",
      "finding": 1,
      "kind": "evaluateCase",
      "base": "cases[0]",
      "mutations": [{ "op": "delete", "path": "mandate.caps" }],
      "expect": {
        "route": "wait",
        "outcomeCode": "data_missing",
        "proposedAction": "WAIT",
        "diagnosticCodes": ["position_cap_not_stated"]
      }
    },
    {
      "id": "an-unreadable-row-is-not-an-adjudicated-account",
      "finding": 1,
      "kind": "evaluateCase",
      "note": "The account was handed over and one open-proposal row has no weight on it. Every Mandate number is present, so the sizing succeeds — and the concentration answer is `null` rather than `false`, which is the state the old `=== false` refusal let straight through. A total this run cannot complete is not a total it may propose against.",
      "base": "cases[0]",
      "mutations": [{ "op": "set", "path": "book.openProposals", "value": [{ "symbol": "000000", "sector": "financials" }] }],
      "expect": {
        "route": "wait",
        "outcomeCode": "data_missing",
        "proposedAction": "WAIT",
        "incrementWeight": 0,
        "diagnosticCodes": ["open_proposal_row_unreadable"]
      }
    },
    {
      "id": "a-declared-gross-cap-binds-the-size",
      "finding": 4,
      "kind": "evaluateCase",
      "base": "cases[0]",
      "note": "79% of the account is invested elsewhere against a declared 80% ceiling. The risk arithmetic asks for 5.33%; the gross axis leaves 1%, and 1% is what is proposed.",
      "mutations": [
        { "op": "set", "path": "mandate.caps.accountGrossCap", "value": 0.8 },
        { "op": "set", "path": "book.holdings", "value": [{ "symbol": "OTHER", "sector": "other", "weight": 0.79 }] }
      ],
      "expect": {
        "proposedAction": "BUY",
        "targetTotalWeight": 0.01,
        "incrementWeight": 0.01,
        "projectedGrossExposure": 0.8,
        "maxTotalWeightBinding": "accountGrossCap"
      }
    },
    {
      "id": "a-declared-gross-cap-refuses-when-there-is-nothing-left",
      "finding": 4,
      "kind": "evaluateCase",
      "base": "cases[0]",
      "mutations": [
        { "op": "set", "path": "mandate.caps.accountGrossCap", "value": 0.8 },
        { "op": "set", "path": "book.holdings", "value": [{ "symbol": "OTHER", "sector": "other", "weight": 0.8 }] }
      ],
      "expect": { "route": "wait", "outcomeCode": "risk_limit_exceeded", "proposedAction": "WAIT", "incrementWeight": 0 }
    },
    {
      "id": "a-book-already-past-its-gross-cap-refuses-before-sizing",
      "finding": 4,
      "kind": "evaluateCase",
      "base": "cases[0]",
      "mutations": [
        { "op": "set", "path": "mandate.caps.accountGrossCap", "value": 0.8 },
        { "op": "set", "path": "book.holdings", "value": [{ "symbol": "OTHER", "sector": "other", "weight": 0.85 }] }
      ],
      "expect": {
        "route": "wait",
        "outcomeCode": "risk_limit_exceeded",
        "proposedAction": "WAIT",
        "diagnosticCodes": ["gross_limit_exceeded"]
      }
    },
    {
      "id": "four-percent-held-is-subtracted-not-added-to",
      "finding": 3,
      "kind": "evaluateCase",
      "base": "cases[0]",
      "note": "The regression that names finding ③: the target is 5.33% of the account **in total**, so a book holding 4% is proposed 1.33% and ends at 5.33% — not at 9.33%.",
      "mutations": [{ "op": "set", "path": "book.holdings", "value": [{ "symbol": "000000", "sector": "financials", "weight": 0.04 }] }],
      "expect": {
        "proposedAction": "BUY",
