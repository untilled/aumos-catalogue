{
  "name": "aumos-catalogue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Submitted ManagerPackages and data sources for the Aumos catalogue",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "node --experimental-strip-types tools/lint/main.ts",
    "lint:sources": "node --experimental-strip-types tools/lint-sources/main.ts",
    "check:docs": "node tools/check-docs.mjs",
    "check:index": "node tools/check-index.mjs",
    "check:pins": "node tools/check-pins.mjs",
    "check:plugin": "node tools/check-plugin.mjs",
    "check:publisher": "node tools/check-publisher.mjs",
    "check:provenance": "node tools/check-provenance.mjs",
    "check:allocator": "node tools/verify-evidence-gated-allocator.mjs",
    "check:diagnostic-codes": "node tools/verify-evidence-gated-diagnostic-codes.mjs",
    "check:delegation": "node tools/verify-evidence-gated-delegation-budget.mjs",
    "check:recipes": "node tools/verify-evidence-gated-recipes.mjs",
    "check:evidence-citation": "node tools/verify-evidence-gated-evidence-citation.mjs",
    "check:catalyst-turnaround": "node tools/verify-catalyst-turnaround.mjs",
    "check:fundamental-mean-reversion": "node tools/verify-fundamental-mean-reversion.mjs",
    "check:amp-price-levels": "node tools/verify-amp-price-levels.mjs",
    "check:shareholder-rerating": "node tools/verify-shareholder-rerating.mjs",
    "check:shared-scenarios": "node tools/verify-shared-scenarios.mjs",
    "check:discovery-contract": "node tools/verify-discovery-contract.mjs",
    "check:legacy-parity": "node tools/legacy-parity.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
