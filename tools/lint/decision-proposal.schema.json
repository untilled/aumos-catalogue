      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "enum": ["equity", "etf", "crypto", "cash"]
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,12}$",
          "description": "MIC-style market identifier, e.g. XNAS"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 currency code"
        }
      },
